// Doom 1-only wall names (not present in registered DOOM2.WAD).
// Enable in GLDEFS.txt when playing Ultimate Doom / Doom 1 TCs.
// Regenerate: tools/generate-materials.ps1

// Doom 1 - stone / masonry
material texture GRAYDANG
{
	shader "SHADERS/envgeneric.fp"
	texture displacement "MATERIALS/ENV/env3.jpg"
	specularlevel 0.2
	glossiness 8
}

